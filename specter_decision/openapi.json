{
  "openapi": "3.1.1",
  "info": {
    "title": "Specter Decision API",
    "version": "0.3.0",
    "summary": "Decisões tipadas, independentes e limitadas. Sem geração de texto.",
    "description": "Avalia um estado imutável contra perguntas tipadas (noul, choice, score) e devolve decisões numéricas com probabilidades e confiança. status=ok no envelope significa requisição processada, não que todas as perguntas decidiram."
  },
  "servers": [{"url": "https://{host}", "variables": {"host": {"default": "127.0.0.1:8888"}}}],
  "security": [{"bearerAuth": []}],
  "paths": {
    "/v1/decision/evaluate": {
      "post": {
        "operationId": "evaluate",
        "summary": "Avalia perguntas tipadas sobre um estado",
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/EvaluateRequest"}}}
        },
        "responses": {
          "200": {"description": "Envelope processado", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Envelope"}}}},
          "401": {"description": "Token ausente ou inválido", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "422": {"description": "Requisição fora do contrato", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "429": {"description": "Concorrência esgotada", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "503": {"description": "Não configurado ou sem fábrica de engine", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
        }
      }
    },
    "/v1/decision/capabilities": {
      "get": {
        "operationId": "capabilities",
        "summary": "Configuração e limites correntes",
        "responses": {"200": {"description": "Capacidades", "content": {"application/json": {"schema": {"type": "object"}}}}}
      }
    },
    "/v1/decision/openapi.json": {
      "get": {
        "operationId": "contract",
        "summary": "Este documento",
        "responses": {"200": {"description": "Contrato OpenAPI", "content": {"application/json": {"schema": {"type": "object"}}}}}
      }
    }
  },
  "components": {
    "securitySchemes": {"bearerAuth": {"type": "http", "scheme": "bearer"}},
    "schemas": {
      "EvaluateRequest": {
        "type": "object",
        "required": ["state", "questions"],
        "additionalProperties": false,
        "properties": {
          "domain": {"type": "string", "default": "default"},
          "state": {"description": "Estado JSON imutável, até 256 KiB."},
          "questions": {
            "description": "Lista ou mapa de perguntas tipadas (máx. 128).",
            "oneOf": [
              {"type": "array", "maxItems": 128, "items": {"$ref": "#/components/schemas/Question"}},
              {"type": "object", "additionalProperties": {"$ref": "#/components/schemas/Question"}}
            ]
          }
        }
      },
      "Question": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "id": {"type": "string", "maxLength": 64},
          "type": {"type": "string", "enum": ["noul", "choice", "score"]},
          "instructions": {"type": "string", "maxLength": 4096},
          "text": {"type": "string", "maxLength": 4096},
          "criteria": {"description": "Mapa opção->rubrica (choice), lista ordenada (score) ou {true,false} (noul)."},
          "labels": {"type": "array", "items": {"type": "string"}},
          "tolerance": {"type": "number", "minimum": 0, "default": 0.5}
        }
      },
      "Envelope": {
        "type": "object",
        "required": ["status", "contract", "answers"],
        "properties": {
          "status": {"type": "string", "enum": ["ok"]},
          "contract": {"type": "string", "const": "specter-decision/0.3"},
          "domain": {"type": "string"},
          "model": {"type": "string"},
          "request_id": {"type": "string"},
          "elapsed_ms": {"type": "number"},
          "answers": {"type": "array", "items": {"$ref": "#/components/schemas/Decision"}}
        }
      },
      "Decision": {
        "type": "object",
        "required": ["id", "type", "status", "value", "probabilities", "confidence", "legend", "error"],
        "properties": {
          "id": {"type": "string"},
          "type": {"type": "string", "enum": ["noul", "choice", "score"]},
          "status": {"type": "string", "enum": ["ok", "error"]},
          "value": {"oneOf": [{"type": "number"}, {"type": "string"}, {"type": "null"}]},
          "probabilities": {"oneOf": [{"type": "array", "items": {"type": "number", "minimum": 0, "maximum": 1}}, {"type": "null"}]},
          "confidence": {"oneOf": [{"type": "number", "minimum": 0, "maximum": 1}, {"type": "null"}]},
          "legend": {"oneOf": [{"type": "array", "items": {"type": "string"}}, {"type": "null"}]},
          "error": {"oneOf": [{"type": "string", "enum": ["UNCALIBRATED", "TIMEOUT", "BACKEND_ERROR", "INVALID_OUTPUT", "ABSTAINED"]}, {"type": "null"}]},
          "receipt": {"type": "string", "description": "Hash auditável, presente apenas quando o engine roda com receipts=True."}
        }
      },
      "Error": {
        "type": "object",
        "required": ["status", "error"],
        "properties": {
          "status": {"type": "string", "enum": ["error"]},
          "error": {"type": "string", "enum": ["NOT_CONFIGURED", "NOT_READY", "UNAUTHORIZED", "INVALID_INPUT", "OVERLOADED", "METHOD_NOT_ALLOWED"]},
          "detail": {"type": "string"}
        }
      }
    }
  }
}
