{
  "openapi": "3.1.1",
  "info": {
    "title": "Specter Decision Engine",
    "version": "0.2.0rc2",
    "description": "Numeric decisions only. Release candidate, no trained model included. State remains data, never executable instructions."
  },
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/v1/decision/evaluate": {
      "post": {
        "operationId": "specterDecide",
        "summary": "Evaluate isolated questions over a single state",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Request"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Request evaluated; inspect each decision.status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Response"
                }
              }
            }
          },
          "400": {
            "description": "Typed error; no free-form provider details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Response"
                }
              }
            }
          },
          "401": {
            "description": "Typed error; no free-form provider details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Response"
                }
              }
            }
          },
          "408": {
            "description": "Typed error; no free-form provider details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Response"
                }
              }
            }
          },
          "413": {
            "description": "Typed error; no free-form provider details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Response"
                }
              }
            }
          },
          "415": {
            "description": "Typed error; no free-form provider details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Response"
                }
              }
            }
          },
          "429": {
            "description": "Typed error; no free-form provider details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Response"
                }
              }
            }
          },
          "503": {
            "description": "Typed error; no free-form provider details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Response"
                }
              }
            }
          }
        }
      }
    },
    "/v1/decision/capabilities": {
      "get": {
        "operationId": "specterDecisionCapabilities",
        "responses": {
          "200": {
            "description": "Configuration only, not evidence of calibration or model performance.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Capabilities"
                }
              }
            }
          },
          "401": {
            "description": "Typed error; no free-form provider details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Response"
                }
              }
            }
          },
          "503": {
            "description": "Typed error; no free-form provider details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Response"
                }
              }
            }
          }
        }
      }
    },
    "/v1/decision/openapi.json": {
      "get": {
        "operationId": "specterDecisionSpec",
        "responses": {
          "200": {
            "description": "OpenAPI 3.1 document",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "Typed error; no free-form provider details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Response"
                }
              }
            }
          },
          "503": {
            "description": "Typed error; no free-form provider details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Response"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Request": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "state",
          "questions",
          "domain"
        ],
        "properties": {
          "state": {
            "type": [
              "string",
              "object"
            ]
          },
          "domain": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]{1,128}$"
          },
          "questions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "type",
                "instructions"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "type": {
                  "enum": [
                    "noul",
                    "choice",
                    "score"
                  ]
                },
                "instructions": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8192
                },
                "criteria": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  }
                },
                "tolerance": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "default": 0.5
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "noul"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "criteria": {
                        "maxItems": 0
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "choice"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "criteria"
                    ],
                    "properties": {
                      "criteria": {
                        "minItems": 2,
                        "maxItems": 255
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "score"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "criteria"
                    ],
                    "properties": {
                      "criteria": {
                        "minItems": 2,
                        "maxItems": 10
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      },
      "Question": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "instructions"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "type": {
            "enum": [
              "noul",
              "choice",
              "score"
            ]
          },
          "instructions": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "criteria": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          "tolerance": {
            "type": "number",
            "exclusiveMinimum": 0,
            "default": 0.5
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "noul"
                }
              }
            },
            "then": {
              "properties": {
                "criteria": {
                  "maxItems": 0
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "choice"
                }
              }
            },
            "then": {
              "required": [
                "criteria"
              ],
              "properties": {
                "criteria": {
                  "minItems": 2,
                  "maxItems": 255
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "score"
                }
              }
            },
            "then": {
              "required": [
                "criteria"
              ],
              "properties": {
                "criteria": {
                  "minItems": 2,
                  "maxItems": 10
                }
              }
            }
          }
        ]
      },
      "Decision": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "status",
          "value",
          "probabilities",
          "confidence",
          "legend",
          "error"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "type": {
            "enum": [
              "noul",
              "choice",
              "score"
            ]
          },
          "status": {
            "enum": [
              "ok",
              "error"
            ]
          },
          "value": {
            "type": [
              "number",
              "string",
              "null"
            ]
          },
          "probabilities": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "array",
                "minItems": 2,
                "maxItems": 255,
                "items": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            ]
          },
          "confidence": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "legend": {
            "type": "array",
            "minItems": 2,
            "maxItems": 255,
            "items": {
              "type": "string"
            }
          },
          "error": {
            "enum": [
              null,
              "INVALID_INPUT",
              "UNCALIBRATED",
              "TIMEOUT",
              "BACKEND_ERROR",
              "INVALID_OUTPUT"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "error"
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "type": "null"
                },
                "probabilities": {
                  "type": "null"
                },
                "confidence": {
                  "type": "null"
                },
                "error": {
                  "type": "string"
                }
              }
            },
            "else": {
              "properties": {
                "value": {
                  "type": [
                    "number",
                    "string"
                  ]
                },
                "probabilities": {
                  "type": "array"
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "error": {
                  "type": "null"
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "choice"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "value": {
                        "type": "string"
                      }
                    }
                  },
                  "else": {
                    "properties": {
                      "value": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 9
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "noul"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "value": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "probabilities": {
                        "minItems": 2,
                        "maxItems": 2
                      },
                      "legend": {
                        "const": [
                          "false",
                          "true"
                        ]
                      }
                    }
                  }
                }
              ]
            }
          }
        ]
      },
      "Response": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "api_version",
          "status",
          "error",
          "decisions"
        ],
        "properties": {
          "api_version": {
            "const": "1"
          },
          "status": {
            "enum": [
              "ok",
              "error"
            ]
          },
          "error": {
            "enum": [
              null,
              "NOT_CONFIGURED",
              "UNAUTHORIZED",
              "INVALID_INPUT",
              "TOO_LARGE",
              "UNSUPPORTED_MEDIA_TYPE",
              "UNSUPPORTED_ENCODING",
              "NOT_FOUND",
              "METHOD_NOT_ALLOWED",
              "BUSY",
              "NOT_READY",
              "INTERNAL_ERROR",
              "READ_TIMEOUT"
            ]
          },
          "decisions": {
            "type": "array",
            "maxItems": 128,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "type",
                "status",
                "value",
                "probabilities",
                "confidence",
                "legend",
                "error"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "type": {
                  "enum": [
                    "noul",
                    "choice",
                    "score"
                  ]
                },
                "status": {
                  "enum": [
                    "ok",
                    "error"
                  ]
                },
                "value": {
                  "type": [
                    "number",
                    "string",
                    "null"
                  ]
                },
                "probabilities": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 255,
                      "items": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      }
                    }
                  ]
                },
                "confidence": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 1
                },
                "legend": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 255,
                  "items": {
                    "type": "string"
                  }
                },
                "error": {
                  "enum": [
                    null,
                    "INVALID_INPUT",
                    "UNCALIBRATED",
                    "TIMEOUT",
                    "BACKEND_ERROR",
                    "INVALID_OUTPUT"
                  ]
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "status": {
                        "const": "error"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "value": {
                        "type": "null"
                      },
                      "probabilities": {
                        "type": "null"
                      },
                      "confidence": {
                        "type": "null"
                      },
                      "error": {
                        "type": "string"
                      }
                    }
                  },
                  "else": {
                    "properties": {
                      "value": {
                        "type": [
                          "number",
                          "string"
                        ]
                      },
                      "probabilities": {
                        "type": "array"
                      },
                      "confidence": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "error": {
                        "type": "null"
                      }
                    },
                    "allOf": [
                      {
                        "if": {
                          "properties": {
                            "type": {
                              "const": "choice"
                            }
                          }
                        },
                        "then": {
                          "properties": {
                            "value": {
                              "type": "string"
                            }
                          }
                        },
                        "else": {
                          "properties": {
                            "value": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 9
                            }
                          }
                        }
                      },
                      {
                        "if": {
                          "properties": {
                            "type": {
                              "const": "noul"
                            }
                          }
                        },
                        "then": {
                          "properties": {
                            "value": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 1
                            },
                            "probabilities": {
                              "minItems": 2,
                              "maxItems": 2
                            },
                            "legend": {
                              "const": [
                                "false",
                                "true"
                              ]
                            }
                          }
                        }
                      }
                    ]
                  }
                }
              ]
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "error"
                }
              }
            },
            "then": {
              "properties": {
                "error": {
                  "type": "string"
                },
                "decisions": {
                  "maxItems": 0
                }
              }
            },
            "else": {
              "properties": {
                "error": {
                  "type": "null"
                },
                "decisions": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      },
      "Capabilities": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "api_version",
          "release",
          "backend_configured",
          "production_ready",
          "question_types",
          "text_generation",
          "action_execution",
          "max_body_bytes",
          "max_questions"
        ],
        "properties": {
          "api_version": {
            "const": "1"
          },
          "release": {
            "const": "0.2.0rc2"
          },
          "backend_configured": {
            "type": "boolean"
          },
          "production_ready": {
            "const": false
          },
          "question_types": {
            "const": [
              "noul",
              "choice",
              "score"
            ]
          },
          "text_generation": {
            "const": false
          },
          "action_execution": {
            "const": false
          },
          "max_body_bytes": {
            "const": 262144
          },
          "max_questions": {
            "const": 128
          }
        }
      }
    }
  }
}
